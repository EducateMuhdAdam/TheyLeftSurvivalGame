[resource]
script = ExtResource("1_0jci8")
messageID = 1
title = "Factory Employee Dismissal Notice (21st March 2295)"
message = "It is with a heavy heart that Nutrisupply Co. will be letting go of all employees working under production, this change affects quality-controll, Reasearch and Development and Logistic departments. Severance pay will be provided to all individuals affected as required by the Production Automation Act 2148

This change is made to provide automation towards production of food for our valued customers during the transition phase towards The Ascension. Therefore, management of the supply chain will be handled by the company Artificial Intelligence Manager (AIM)

NutriSupply Co. wishes the best for all your future endeavours.

C.E.O of Nutrisupply,
David Blancc"
metadata/_custom_type_script = "uid://clg6sgwgkl1xk"
