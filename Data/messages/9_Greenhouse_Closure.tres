script = ExtResource("1_7tltu")
messageID = 9
title = "Closure Notice (5 August 2294)"
message = "Due to the lack of non-contaminated water, the greenhouse will unfortunately have to be closed down. The plants are wilting and the cost to retrieve clean water is greater than the profits from the produce we sell

Silver lining, we will be available after The Ascension so follow our socials to see when and where we will pop around"
